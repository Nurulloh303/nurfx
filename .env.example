# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nurfx.ai
DJANGO_CORS_ALLOWED_ORIGINS=https://nurfx.ai,https://www.nurfx.ai,http://localhost:3000,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=https://nurfx.ai,https://www.nurfx.ai,http://localhost:3000,http://localhost:5173
# Change this to a secret, hard-to-guess path in production, e.g. secure-panel-x7f2/
DJANGO_ADMIN_URL=admin/

# Database
POSTGRES_USER=nurfx
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=nurfx_db
# Keep the password in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgres://nurfx:change-me-to-a-long-random-password@db:5432/nurfx_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI provider (Anthropic only)
ANTHROPIC_API_KEY=sk-ant-...
AI_CLAUDE_MODEL=claude-opus-5
AI_CLAUDE_EFFORT=high
AI_CLAUDE_MAX_TOKENS=16000
AI_ENABLE_REFUSAL_FALLBACK=True

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
TELEGRAM_ADMIN_IDS=123456789,987654321

# Payment details shown to buyers (personal data — keep out of git)
NURFX_PAYMENT_CARD_NUMBER=0000 0000 0000 0000
NURFX_PAYMENT_CARD_HOLDER=Card Holder Name
NURFX_ADMIN_TELEGRAM_USERNAME=your_telegram_username

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
